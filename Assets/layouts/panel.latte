<!DOCTYPE html>
<html lang="en" data-app-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{$pageTitle ?? 'Panel'}</title>
        {$cssOutput|noescape}
    </head>
    <body
        data-panel-route-url="{$currentRouteUrl ?? ''}"
        data-panel-route-label="{$currentRouteLabel ?? $pageTitle ?? ''}"
        data-panel-route-description="{$currentRouteDescription ?? $pageDescription ?? ''}"
        data-panel-route-icon="{$currentRouteIcon !== '' ? base64_encode($currentRouteIcon) : ''}"
    >
        <!-- Overlay for mobile sidebar -->
        <div class="panel-sidebar-overlay" id="sidebar-overlay"></div>
        <!-- End Overlay for mobile sidebar -->
        <!-- Shell --->
        <div class="panel-shell">
            <!-- Sidebar -->
            <aside class="panel-sidebar" id="panel-sidebar">
                <a class="panel-sidebar-brand" href="/">
                    {if $appLogo !== ''}
                        <span class="panel-sidebar-brand-mark panel-sidebar-brand-mark-image" data-app-brand-logo >
                            <img class="panel-sidebar-brand-image" src="{$appLogo}" alt="">
                        </span>
                    {else}
                        <span class="panel-sidebar-brand-mark panel-sidebar-brand-mark-fallback" data-app-brand-logo >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="app-icon" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492M5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0"/>
                                <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115z"/>
                            </svg>
                        </span>
                    {/if}

                    <span class="panel-sidebar-brand-text" data-app-brand-name>{$appName}</span>
                </a>
                <nav class="panel-sidebar-nav" aria-label="Administration navigation">
                    {$sidebarMenu|noescape}
                </nav>
            </aside>
            <!-- End Sidebar -->
            <!-- Main column -->
            <div class="panel-main" id="panel-main">
                <!-- Topbar -->
                <header class="panel-topbar">
                    <button class="panel-topbar-toggle" id="sidebar-toggle" type="button" aria-label="Toggle sidebar" aria-controls="panel-sidebar" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="app-icon panel-sidebar-toggle-button" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
                        </svg>
                    </button>
                    <div class="panel-topbar-information">
                        <div class="panel-topbar-history">
                            {$historyBreadcrumbs|noescape}
                        </div>
                        <div class="panel-topbar-title">{$pageTitle}</div>
                        {if $pageDescription !== ''}
                            <div class="panel-topbar-description">{$pageDescription}</div>
                        {/if}
                    </div>
                    <div class="panel-topbar-actions">
                        <!-- Theme selector -->
                        <div class="panel-theme-selector">
                            <button class="panel-topbar-icon-btn" id="app-theme-toggle" type="button" aria-controls="app-theme-menu" aria-haspopup="true" aria-expanded="false" title="Switch theme">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="app-icon panel-theme-selector-icon" viewBox="0 0 16 16">
                                    <path d="M8 15A7 7 0 1 0 8 1zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16"/>
                                </svg>
                            </button>
                            <ul class="panel-theme-menu" id="app-theme-menu" hidden>
                                <li>
                                    <button class="panel-theme-option" data-theme-value="dark">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="app-icon panel-theme-selector-icon" viewBox="0 0 16 16">
                                            <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278"/>
                                            <path d="M10.794 3.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387a1.73 1.73 0 0 0-1.097 1.097l-.387 1.162a.217.217 0 0 1-.412 0l-.387-1.162A1.73 1.73 0 0 0 9.31 6.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387a1.73 1.73 0 0 0 1.097-1.097zM13.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.16 1.16 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.16 1.16 0 0 0-.732-.732l-.774-.258a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732z"/>
                                        </svg>
                                        Dark
                                    </button>
                                </li>
                                <li>
                                    <button class="panel-theme-option" data-theme-value="light">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="app-icon panel-theme-selector-icon" viewBox="0 0 16 16">
                                            <path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"/>
                                        </svg>
                                        Light
                                    </button>
                                </li>
                                <li>
                                    <button class="panel-theme-option" data-theme-value="auto">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="app-icon panel-theme-selector-icon" viewBox="0 0 16 16">
                                            <path d="M8 15A7 7 0 1 0 8 1zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16"/>
                                        </svg>
                                        Auto
                                    </button>
                                </li>
                            </ul>
                        </div>

                        {$userMenu|noescape}
                    </div>
                </header>
                <!-- End Topbar -->
                <!-- Page content -->
                <main class="panel-content page-content" id="panel-page-content">
                    {$routeBreadcrumbs|noescape}
                    {$templateContent|noescape}
                </main>
                <!-- End Page content -->
                <!-- Footer -->
                <footer class="panel-footer">
                    <span>&copy; {$year} {$appName}</span>
                    {if $appFooter !== ''}
                        <span class="panel-footer-content">{$appFooter}</span>
                    {/if}
                </footer>
                <!-- End Footer -->
            </div>
            <!-- End Main column -->
        </div>
        <!-- End Shell --->
        {$jsOutput|noescape}
    </body>
</html>
