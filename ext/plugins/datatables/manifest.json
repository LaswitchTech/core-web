{
    "type": "plugin",
    "name": "datatables",
    "version": "2.3.8",
    "description": "First-party DataTables assets with Bootstrap 5 integration.",
    "depends": [
        "jquery",
        "bootstrap",
        "jszip",
        "pdfmake"
    ],
    "autoload": {
        "psr-4": {
