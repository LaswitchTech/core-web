{
    "type": "plugin",
    "name": "Bootstrap",
    "version": "5.3.3",
    "description": "First-party Bootstrap 5.3 framework assets.",
    "depends": [
        "jquery"
    ],
    "autoload": {
        "psr-4": {
            "Laswitchtech\\CoreWeb\\Plugin\\Bootstrap\\": "src/Bootstrap/",
            "Laswitchtech\\CoreWeb\\Plugin\\BootstrapIcons\\": "src/BootstrapIcons/"
        }
    },
    "hooks": [
        "asset.register::Laswitchtech\\CoreWeb\\Plugin\\BootstrapIcons\\BootstrapIconsAssetProvider::registerAssets",
        "asset.register::Laswitchtech\\CoreWeb\\Plugin\\Bootstrap\\BootstrapAssetProvider::registerAssets",
        "router.register::Laswitchtech\\CoreWeb\\Plugin\\BootstrapIcons\\BootstrapIconsFontProvider::registerRoutes"
    ]
}
