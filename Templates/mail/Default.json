    "htmlBody": "<!DOCTYPE html>\n<html lang=\"en\" style=\"margin: 0;padding: 0;\">\n    <head>\n        <meta http-equiv=\"Content-Type\" content=\"text/html\">\n        <meta name=\"viewport\" content=\"width=device-width\">\n        <meta name=\"format-detection\" content=\"telephone=no\">\n        <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n    </head>\n    <body style=\"font-size: 18px;width: 100% !important;background-color: white;margin: 0;padding: 0;font-family:'Helvetica Neue','Arial','Helvetica','Verdana',sans-serif;color: #333333;line-height: 26px;\">\n        <table style=\"border-collapse: collapse;\" width=\"100%\" height=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\">\n            <tbody>\n                <tr><td class=\"top-padding\" style=\"line-height:64px;height:64px;\" width=\"100%\"></td></tr>\n                <tr>\n                    <td valign=\"top\">\n                        <table style=\"border-collapse: collapse;\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                            <tbody>\n                                <tr style=\"width:100%!important;\" align=\"center\">\n                                    <td>\n                                        <table style=\"border-collapse: collapse;\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\">\n                                            <tbody>\n                                                <tr width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                                                    <td style=\"padding:0px 0px 0px 0px;\" align=\"center\">\n                                                        <div style=\"color:#495057; text-align: center; padding-bottom: 20px;\">\n                                                            <img src=\"{AppLogo}\" alt=\"logo\" style=\"min-width:100px;max-height:250px;vertical-align: middle;border-style: none;\">\n                                                            <br>\n                                                            <b style=\"font-family:'Helvetica Neue','Arial','Helvetica','Verdana',sans-serif; font-size:52px; font-weight: 200; line-height:56px;vertical-align: -20px;\">{AppName}</b>\n                                                        </div>\n                                                    </td>\n                                                </tr>\n                                                <tr>\n                                                    <td style=\"padding:0px 0px 0px 0px;\" valign=\"top\" align=\"center\">\n                                                        <table style=\"border-collapse: collapse;\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\">\n                                                            <tbody>\n                                                                <tr align=\"center\">\n                                                                    <td class=\"heading\" style=\"font-family:'Helvetica Neue','Arial','Helvetica','Verdana',sans-serif; font-size:32px; line-height:32px; font-weight: 200;padding:20px 0px 32px 0px; margin:0; border: 0; display:block; text-align:center;\" width=\"90%\" align=\"center\">{Subject}</td>\n                                                                </tr>\n                                                            </tbody>\n                                                        </table>\n                                                    </td>\n                                                </tr>\n                                            </tbody>\n                                        </table>\n                                        <table style=\"border-collapse: collapse;\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\">\n                                            <tbody>\n                                                <tr>\n                                                    <td style=\"color:#333333; padding:0px 0px 64px 0px; margin:0px;vertical-align: text-top;\" class=\"emailcontent\" width=\"100%\">\n                                                        <table style=\"border-collapse: collapse;\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\">\n                                                            <tbody>\n                                                                <tr>\n                                                                    <td style=\"padding: 24px;\">\n                                                                        <table style=\"border-collapse: collapse;\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\">\n                                                                            <tbody>\n                                                                                <tr>\n                                                                                    <td style=\"padding:7px 0 19px; margin:0; font-family:'Helvetica Neue','Arial','Helvetica','Verdana',sans-serif; color: #333333;font-size:18px; line-height: 26px; width:100%; text-align:justify\">\n                                                                                        <p>Hello {RecipientName},</p>\n                                                                                        <p>{Body}</p>\n                                                                                    </td>\n                                                                                </tr>\n                                                                            </tbody>\n                                                                        </table>\n                                                                        <table style=\"border-collapse: collapse;\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\">\n                                                                            <tbody>\n                                                                                <tr>\n                                                                                    <td style=\"padding:7px 0 19px; margin:0; font-family:'Helvetica Neue','Arial','Helvetica','Verdana',sans-serif; color: #333333;font-size:18px; line-height: 26px; width:100%\">\n                                                                                        {Greetings}\n                                                                                    </td>\n                                                                                </tr>\n                                                                            </tbody>\n                                                                        </table>\n                                                                    </td>\n                                                                </tr>\n                                                            </tbody>\n                                                        </table>\n                                                    </td>\n                                                </tr>\n                                            </tbody>\n                                        </table>\n                                    </td>\n                                </tr>\n                                <tr style=\"width:100%!important; background-color:#343A40;\" align=\"center\">\n                                    <td class=\"footer\" style=\"padding-top: 64px; padding-bottom: 64px\">\n                                        <table style=\"border-collapse: collapse;\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\">\n                                            <tbody>\n                                                <tr width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                                                    <td style=\"font-family:'Helvetica Neue','Arial','Helvetica','Verdana',sans-serif;color:#999999; text-align:center; font-size:12px; line-height:16px; padding:4px;\" align=\"center\">\n                                                        TradeMark and Copyright &copy; {CurrentYear}\n                                                    </td>\n                                                </tr>\n                                                <tr width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                                                    <td style=\"font-family:'Helvetica Neue','Arial','Helvetica','Verdana',sans-serif;text-align:center; font-size:12px; line-height:16px; color:#999999\" align=\"center\">\n                                                        <a style=\"text-decoration: none;margin-left:4px;margin-right:4px;color:#ffffff;\" href=\"{TermsUrl}\" moz-do-not-send=\"true\">All Rights Reserved</a>\n                                                        <a style=\"text-decoration: none;margin-left:4px;margin-right:4px;color:#ffffff;\" href=\"{PrivacyUrl}\" moz-do-not-send=\"true\">Privacy Policy</a>\n                                                        <a style=\"text-decoration: none;margin-left:4px;margin-right:4px;color:#ffffff;\" href=\"{SupportUrl}\" moz-do-not-send=\"true\">Support</a>\n                                                    </td>\n                                                </tr>\n                                                <tr width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                                                    <td style=\"font-family:'Helvetica Neue','Arial','Helvetica','Verdana',sans-serif;color:#999999; text-align:center; font-size:12px; line-height:16px; padding:4px;padding-top:32px; \" align=\"center\">\n       